# Keep the build context small and keep secrets out of the image.

# Rebuilt inside the image for the container's architecture.
node_modules/

# Secrets — the container gets its config from the environment instead.
.env
.env.docker
.env.local
*.pem
*.key

.git/
.github/
.gitignore

# Server deployment tooling, irrelevant inside a container.
deploy/

# Terraform config. Runs from the laptop against the AWS API — it has no
# business inside the application image, and *.tfstate must never reach one.
infra/
*.tfstate
*.tfstate.*
*.tfvars

*.md
npm-debug.log*
.vscode/
.idea/
Dockerfile
.dockerignore
docker-compose.yml

# Lint config — dev tooling, not needed at runtime.
eslint.config.js

# Kubernetes manifests and specs — cluster and repo tooling, not runtime files.
# k8s/secret.yaml in particular must never reach an image.
#
# Note the `*.md` rule above does NOT cover docs/: Docker ignore patterns do
# not cross a `/`, so `*.md` matches only top-level files.
k8s/
docs/
.superpowers/
