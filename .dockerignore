# Keep the build context small and keep secrets out of the image.

# Rebuilt inside the image for the container's architecture.
node_modules/

# Secrets — the container gets its config from the environment instead.
.env
.env.docker
.env.local
*.pem
*.key

.git/
.github/
.gitignore

# Server deployment tooling, irrelevant inside a container.
deploy/

# Terraform config. Runs from the laptop against the AWS API — it has no
# business inside the application image, and *.tfstate must never reach one.
infra/
*.tfstate
*.tfstate.*
*.tfvars

*.md
npm-debug.log*
.vscode/
.idea/
Dockerfile
.dockerignore
docker-compose.yml

# Lint config — dev tooling, not needed at runtime.
eslint.config.js
