# DuckDNS dynamic DNS updater — checks every 5 minutes.
#
# Install on the server:
#   sudo cp /var/www/crud/deploy/aws/duckdns.cron /etc/cron.d/duckdns
#   sudo chmod 644 /etc/cron.d/duckdns
#   sudo chown root:root /etc/cron.d/duckdns
#
# Runs as root so it can write /var/lib/duckdns and /var/log/duckdns.log.
# The script itself only contacts DuckDNS when the IP actually changed, so this
# is 288 cheap local checks a day, not 288 API calls.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

*/5 * * * * root /var/www/crud/deploy/aws/duckdns-update.sh
